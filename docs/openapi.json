{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Pedidos — case DevOpsDays Recife",
    "version": "1.0.0",
    "description": "Cenários didáticos, sem pagamento ou estoque reais."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Healthcheck",
        "responses": {
          "200": {
            "description": "Servidor disponível"
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Cria pedido, sem garantia de confirmação de negócio",
        "responses": {
          "201": {
            "description": "Recurso criado; estado pode ser PENDING, CONFIRMED, REJECTED ou REQUIRES_COMPENSATION"
          },
          "400": {
            "description": "Pedido inválido"
          },
          "415": {
            "description": "Tipo não suportado"
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "summary": "Consultar estado de pedido",
        "responses": {
          "200": {
            "description": "Pedido encontrado"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      }
    },
    "/orders/{id}/flow": {
      "get": {
        "summary": "Fluxo e etapas do pedido",
        "responses": {
          "200": {
            "description": "Timeline do pedido"
          },
          "404": {
            "description": "Não encontrado"
          }
        }
      }
    },
    "/scenarios": {
      "get": {
        "summary": "Lista fixtures didáticas",
        "responses": {
          "200": {
            "description": "Cenários disponíveis"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Contadores didáticos sem identificadores",
        "responses": {
          "200": {
            "description": "Métricas em formato texto"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "paymentStatus": {
            "type": "string"
          },
          "stockStatus": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "REJECTED",
              "REQUIRES_COMPENSATION"
            ]
          },
          "compensationRequired": {
            "type": "boolean"
          }
        }
      },
      "FlowStep": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer"
          },
          "stage": {
            "type": "string",
            "enum": [
              "REQUEST",
              "PAYMENT",
              "STOCK",
              "DOMAIN_RULE",
              "ORDER_STATE"
            ]
          },
          "result": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "OrderFlow": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "REJECTED",
              "REQUIRES_COMPENSATION"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlowStep"
            }
          }
        }
      }
    }
  }
}
